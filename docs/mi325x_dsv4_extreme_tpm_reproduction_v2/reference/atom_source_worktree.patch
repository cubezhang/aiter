diff --git a/atom/entrypoints/openai/chat_encoders.py b/atom/entrypoints/openai/chat_encoders.py
index d3fb0462..35cf612d 100644
--- a/atom/entrypoints/openai/chat_encoders.py
+++ b/atom/entrypoints/openai/chat_encoders.py
@@ -68,6 +68,15 @@ def _load_encoder_from_dir(model_path: str) -> Optional[MessageEncoder]:
     # also valid is "chat" (non-thinking short-form). May need to add as an option.
     # Revisit when a second model ships an encode_*.py — the default may need to be per-model.
     def encode(messages, **kwargs):
+        # The existing strict-contract/Jinja path uses a boolean `thinking`
+        # template kwarg. DeepSeek-V4's Python encoder exposes the equivalent
+        # choice as `thinking_mode="thinking"|"chat"`; translate the legacy
+        # spelling so the same manifest semantics survive encoder dispatch.
+        legacy_thinking = kwargs.pop("thinking", None)
+        if legacy_thinking is not None:
+            kwargs.setdefault(
+                "thinking_mode", "thinking" if legacy_thinking else "chat"
+            )
         kwargs.setdefault("thinking_mode", "thinking")
         return raw(messages, **kwargs)
 
